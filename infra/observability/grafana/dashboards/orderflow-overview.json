        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "orderflow_outbox_pending{measure=\"oldest_age_seconds\"}",
          "legendFormat": "idade",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
