# OrderFlow — variáveis de ambiente locais.
# Copie para `.env` (nunca versionado). Valores abaixo são APENAS para desenvolvimento local.
# O Docker Compose funciona sem `.env`; use-o para trocar portas ou rodar as apps nativamente.

# ---------------------------------------------------------------------------
# Docker Compose — portas publicadas no host (mude se já estiverem em uso)
# ---------------------------------------------------------------------------
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
FLOWER_HOST_PORT=5555

# Credenciais dos serviços de infraestrutura locais
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=orderflow
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=orderflow

# ---------------------------------------------------------------------------
# Backend — usado ao rodar Django/Celery/pytest nativamente (fora do Compose).
# As URLs apontam para as portas publicadas no host acima.
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
# Mínimo de 32 bytes: também assina os JWT (HMAC-SHA256). Em produção, use 50+ caracteres aleatórios.
DJANGO_SECRET_KEY=local-only-insecure-secret-key-change-me-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://orderflow:orderflow@localhost:5432/orderflow
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://orderflow:orderflow@localhost:5672//
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=600/min
# Regras de negócio (horas / ms / dias)
STOCK_RESERVATION_TTL_HOURS=48
STOCK_LOCK_TIMEOUT_MS=3000
ORDER_PENDING_MAX_AGE_DAYS=7
# Integrações (só existem os adapters simulados: "fake")
PAYMENT_GATEWAY=fake
PAYMENT_RECONCILIATION_MAX_ATTEMPTS=10
SHIPPING_PROVIDER=fake
# Minutos entre consultas de rastreio (padrão 60; em dev, 1)
SHIPMENT_TRACKING_INTERVAL_MINUTES=1
# Só a transportadora simulada: minutos entre o despacho e a entrega
FAKE_SHIPPING_TRANSIT_MINUTES=2

# ---------------------------------------------------------------------------
# Frontend — destino do proxy do Vite para /api e /health
# ---------------------------------------------------------------------------
VITE_API_PROXY_TARGET=http://localhost:8000
